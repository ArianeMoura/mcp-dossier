// Type-checks what the build leaves out. `tsconfig.json` excludes tests so they
// stay out of dist, and vitest transpiles without checking, so without this the
// test suite is the one part of the codebase nothing type-checks.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
