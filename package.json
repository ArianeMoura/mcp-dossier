{
  "name": "mcp-dossier",
  "version": "0.0.1",
  "description": "Archaeological intelligence about a git repository, over MCP. It doesn't act on your code — it answers questions about its history.",
  "type": "module",
  "author": "Ariane Moura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArianeMoura/mcp-dossier.git"
  },
  "homepage": "https://github.com/ArianeMoura/mcp-dossier#readme",
  "bugs": "https://github.com/ArianeMoura/mcp-dossier/issues",
  "bin": {
    "mcp-dossier": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "code-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
